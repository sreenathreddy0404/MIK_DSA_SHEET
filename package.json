{
  "name": "dsa-sheet",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w dsa-sheet-backend\" \"npm run dev -w dsa-sheet-frontend\"",
    "dev:web": "npm run dev -w dsa-sheet-frontend",
    "dev:api": "npm run dev -w dsa-sheet-backend",
    "build": "npm run build -w dsa-sheet-frontend",
    "preview": "npm run preview -w dsa-sheet-frontend",
    "seed": "npm run seed -w dsa-sheet-backend",
    "lint": "npm run lint -w dsa-sheet-frontend && npm run lint -w dsa-sheet-backend",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3"
  }
}