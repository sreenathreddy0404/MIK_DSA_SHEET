# Frontend (Vite) — copy this file to `.env` and adjust values.
# The Express API is proxied at /api during development (default target: http://localhost:5000),
# so VITE_API_URL can stay empty unless you run the API on a different host/port.
VITE_API_URL=
# Set to "true" to show the "Continue with Google" button. The backend must have
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET configured (see backend/.env.example).
VITE_GOOGLE_AUTH_ENABLED=false